{
  "name": "school-platform",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-runner.js",
    "dev:raw": "npm run dev:build && concurrently -k -n \"Vite,D1-API\" -c \"cyan.bold,magenta.bold\" \"vite\" \"wrangler dev .wrangler/dist/index.js --port 8788\"",
    "dev:build": "wrangler pages functions build functions --outdir .wrangler/dist",
    "dev:frontend": "vite",
    "dev:functions": "wrangler dev .wrangler/dist/index.js --port 8788",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "firebase": "^12.11.0",
    "jose": "^6.2.7",
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.1",
    "three": "^0.185.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^10.0.4",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "vite": "^7.3.1",
    "wrangler": "^4.118.0"
  }
}
